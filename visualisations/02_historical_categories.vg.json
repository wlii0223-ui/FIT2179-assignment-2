{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 470,
  "height": 310,
  "title": {
    "text": "Historical event composition",
    "subtitle": "One square represents about two recorded events."
  },
  "data": {
    "sequence": {"start": 0, "stop": 133, "step": 1, "as": "tile"}
  },
  "transform": [
    {
      "calculate": "datum.tile < 32 ? 'Flood' : datum.tile < 60 ? 'Bushfire' : datum.tile < 84 ? 'Severe Storm' : datum.tile < 100 ? 'Cyclone' : datum.tile < 115 ? 'Environmental' : datum.tile < 126 ? 'Hail' : datum.tile < 129 ? 'Earthquake' : datum.tile < 131 ? 'Landslide' : 'Tornado'",
      "as": "category"
    },
    {
      "calculate": "datum.category == 'Flood' ? datum.tile : datum.category == 'Bushfire' ? datum.tile - 32 : datum.category == 'Severe Storm' ? datum.tile - 60 : datum.category == 'Cyclone' ? datum.tile - 84 : datum.category == 'Environmental' ? datum.tile - 100 : datum.category == 'Hail' ? datum.tile - 115 : datum.category == 'Earthquake' ? datum.tile - 126 : datum.category == 'Landslide' ? datum.tile - 129 : datum.tile - 131",
      "as": "unit"
    },
    {
      "calculate": "datum.category == 'Flood' ? 64 : datum.category == 'Bushfire' ? 55 : datum.category == 'Severe Storm' ? 47 : datum.category == 'Cyclone' ? 31 : datum.category == 'Environmental' ? 30 : datum.category == 'Hail' ? 21 : datum.category == 'Earthquake' ? 5 : datum.category == 'Landslide' ? 4 : 3",
      "as": "events"
    },
    {"calculate": "ceil(datum.events / 2) - 1", "as": "last_unit"}
  ],
  "layer": [
    {
      "mark": {"type": "square", "size": 92, "filled": true, "opacity": 0.92},
      "encoding": {
        "x": {
          "field": "unit",
          "type": "quantitative",
          "axis": null,
          "scale": {"domain": [0, 36]}
        },
        "y": {
          "field": "category",
          "type": "nominal",
          "sort": ["Flood", "Bushfire", "Severe Storm", "Cyclone", "Environmental", "Hail", "Earthquake", "Landslide", "Tornado"],
          "title": null
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": ["Flood", "Bushfire", "Severe Storm", "Cyclone", "Environmental", "Hail", "Earthquake", "Landslide", "Tornado"],
            "range": ["#246a8d", "#c85a2e", "#6c5f9f", "#5f7fa3", "#8a6335", "#d09a2d", "#5f5147", "#7f8fa1", "#5a788a"]
          }
        },
        "tooltip": [
          {"field": "category", "type": "nominal", "title": "Type"},
          {"field": "events", "type": "quantitative", "title": "Recorded events"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.unit == datum.last_unit"}],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 12, "font": "Trebuchet MS", "fontSize": 14, "fontWeight": "bold", "color": "#18211d"},
      "encoding": {
        "x": {"field": "unit", "type": "quantitative", "scale": {"domain": [0, 36]}},
        "y": {"field": "category", "type": "nominal", "sort": ["Flood", "Bushfire", "Severe Storm", "Cyclone", "Environmental", "Hail", "Earthquake", "Landslide", "Tornado"]},
        "text": {"field": "events", "type": "quantitative", "format": ".0f"}
      }
    }
  ],
  "config": {
    "background": null,
    "axis": {"labelFont": "Trebuchet MS", "titleFont": "Trebuchet MS", "grid": false, "domain": false},
    "title": {"font": "Georgia", "fontSize": 17, "subtitleFont": "Trebuchet MS", "subtitleFontSize": 12, "anchor": "start"},
    "view": {"stroke": null}
  }
}
