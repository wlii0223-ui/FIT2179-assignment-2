{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 430,
  "height": 385,
  "title": {
    "text": "Recovery activations by hazard share",
    "subtitle": "Radial spokes show relative activation volume."
  },
  "data": {"url": "../processed_data/drfa_hazard_counts.csv"},
  "transform": [
    {
      "window": [{"op": "row_number", "as": "rank"}],
      "sort": [{"field": "activations", "order": "descending"}]
    },
    {"calculate": "-1.25 + (datum.rank - 1) * 0.625", "as": "angle"},
    {"calculate": "sqrt(datum.activations)", "as": "radius"},
    {"calculate": "0", "as": "zero_x"},
    {"calculate": "0", "as": "zero_y"},
    {"calculate": "cos(datum.angle) * datum.radius", "as": "x"},
    {"calculate": "sin(datum.angle) * datum.radius", "as": "y"},
    {"calculate": "datum.hazard_group == 'Flood / Rainfall' ? 'Flood / rainfall: 3,377 activations, about 56% of DRFA records.' : ''", "as": "annotation"}
  ],
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 2.2, "opacity": 0.58},
      "encoding": {
        "x": {"field": "zero_x", "type": "quantitative", "axis": null, "scale": {"domain": [-78, 82], "range": [15, 415]}},
        "y": {"field": "zero_y", "type": "quantitative", "axis": null, "scale": {"domain": [-78, 78], "range": [330, 28]}},
        "x2": {"field": "x", "type": "quantitative", "scale": {"domain": [-78, 82], "range": [15, 415]}},
        "y2": {"field": "y", "type": "quantitative", "scale": {"domain": [-78, 78], "range": [330, 28]}},
        "color": {
          "field": "hazard_group",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": ["Flood / Rainfall", "Storm", "Bushfire", "Cyclone / Tropical Low", "Other"],
            "range": ["#246a8d", "#6c5f9f", "#c85a2e", "#5f7fa3", "#8b7a62"]
          }
        }
      }
    },
    {
      "mark": {"type": "circle", "opacity": 0.88, "stroke": "#fffaf1", "strokeWidth": 2},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "axis": null, "scale": {"domain": [-78, 82], "range": [15, 415]}},
        "y": {"field": "y", "type": "quantitative", "axis": null, "scale": {"domain": [-78, 78], "range": [330, 28]}},
        "size": {"field": "activations", "type": "quantitative", "scale": {"range": [260, 5200]}, "legend": null},
        "color": {
          "field": "hazard_group",
          "type": "nominal",
          "title": "Hazard",
          "scale": {
            "domain": ["Flood / Rainfall", "Storm", "Bushfire", "Cyclone / Tropical Low", "Other"],
            "range": ["#246a8d", "#6c5f9f", "#c85a2e", "#5f7fa3", "#8b7a62"]
          },
          "legend": {
            "orient": "bottom",
            "columns": 3,
            "labelExpr": "datum.label == 'Flood / Rainfall' ? 'Flood / Rain' : datum.label == 'Cyclone / Tropical Low' ? 'Cyclone' : datum.label"
          }
        },
        "tooltip": [
          {"field": "hazard_group", "type": "nominal", "title": "Hazard"},
          {"field": "activations", "type": "quantitative", "title": "Activations", "format": ","}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.hazard_group == 'Flood / Rainfall'"}],
      "mark": {"type": "text", "align": "left", "baseline": "top", "font": "Trebuchet MS", "fontSize": 12, "fontWeight": "bold", "color": "#246a8d"},
      "encoding": {
        "x": {"value": 22},
        "y": {"value": 305},
        "text": {"field": "annotation", "type": "nominal"}
      }
    },
    {
      "data": {
        "values": [
          {"x": 314, "y": 184, "label": "Circle area = activations"}
        ]
      },
      "mark": {"type": "text", "align": "left", "baseline": "middle", "font": "Trebuchet MS", "fontSize": 12, "fontWeight": "bold", "color": "#18211d"},
      "encoding": {
        "x": {"value": 314},
        "y": {"value": 184},
        "text": {"field": "label", "type": "nominal"}
      }
    },
    {
      "data": {
        "values": [
          {"x": 324, "y": 210, "size": 260, "label": "500"},
          {"x": 324, "y": 236, "size": 560, "label": "1,500"},
          {"x": 324, "y": 266, "size": 940, "label": "3,000"}
        ]
      },
      "mark": {"type": "circle", "opacity": 0.32, "fill": "#246a8d", "stroke": "#246a8d", "strokeWidth": 1.2},
      "encoding": {
        "x": {"value": 324},
        "y": {"field": "y", "type": "quantitative", "axis": null, "scale": {"domain": [180, 290], "range": [180, 290]}},
        "size": {"field": "size", "type": "quantitative", "scale": {"domain": [0, 1000], "range": [0, 1000]}, "legend": null}
      }
    },
    {
      "data": {
        "values": [
          {"x": 348, "y": 210, "label": "500"},
          {"x": 348, "y": 236, "label": "1,500"},
          {"x": 348, "y": 266, "label": "3,000"}
        ]
      },
      "mark": {"type": "text", "align": "left", "baseline": "middle", "font": "Trebuchet MS", "fontSize": 11, "color": "#5f6b66"},
      "encoding": {
        "x": {"value": 348},
        "y": {"field": "y", "type": "quantitative", "axis": null, "scale": {"domain": [180, 290], "range": [180, 290]}},
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ],
  "resolve": {"scale": {"color": "independent", "x": "independent", "y": "independent", "size": "independent"}},
  "config": {
    "background": null,
    "legend": {"labelFont": "Trebuchet MS", "titleFont": "Trebuchet MS"},
    "title": {"font": "Georgia", "fontSize": 17, "subtitleFont": "Trebuchet MS", "subtitleFontSize": 12, "anchor": "start"},
    "view": {"stroke": null}
  }
}
