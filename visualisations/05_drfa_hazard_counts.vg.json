{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 430,
  "height": 345,
  "title": {
    "text": "Recovery activations by hazard share",
    "subtitle": "Radial spokes show relative activation volume."
  },
  "data": {"url": "../processed_data/drfa_hazard_counts.csv"},
  "transform": [
    {
      "window": [{"op": "row_number", "as": "rank"}],
      "sort": [{"field": "activations", "order": "descending"}]
    },
    {"calculate": "-1.25 + (datum.rank - 1) * 0.625", "as": "angle"},
    {"calculate": "sqrt(datum.activations)", "as": "radius"},
    {"calculate": "0", "as": "zero_x"},
    {"calculate": "0", "as": "zero_y"},
    {"calculate": "cos(datum.angle) * datum.radius", "as": "x"},
    {"calculate": "sin(datum.angle) * datum.radius", "as": "y"},
    {"calculate": "cos(datum.angle) * (datum.radius + 10)", "as": "label_x"},
    {"calculate": "sin(datum.angle) * (datum.radius + 10)", "as": "label_y"},
    {"calculate": "datum.hazard_group == 'Flood / Rainfall' ? 'Flood / Rain' : datum.hazard_group == 'Cyclone / Tropical Low' ? 'Cyclone' : datum.hazard_group", "as": "hazard_label"}
  ],
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 2.2, "opacity": 0.58},
      "encoding": {
        "x": {"field": "zero_x", "type": "quantitative", "axis": null, "scale": {"domain": [-70, 70], "range": [15, 415]}},
        "y": {"field": "zero_y", "type": "quantitative", "axis": null, "scale": {"domain": [-70, 70], "range": [330, 28]}},
        "x2": {"field": "x", "type": "quantitative", "scale": {"domain": [-70, 70], "range": [15, 415]}},
        "y2": {"field": "y", "type": "quantitative", "scale": {"domain": [-70, 70], "range": [330, 28]}},
        "color": {
          "field": "hazard_group",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": ["Flood / Rainfall", "Storm", "Bushfire", "Cyclone / Tropical Low", "Other"],
            "range": ["#246a8d", "#6c5f9f", "#c85a2e", "#5f7fa3", "#8b7a62"]
          }
        }
      }
    },
    {
      "mark": {"type": "circle", "opacity": 0.88, "stroke": "#fffaf1", "strokeWidth": 2},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "axis": null, "scale": {"domain": [-70, 70], "range": [15, 415]}},
        "y": {"field": "y", "type": "quantitative", "axis": null, "scale": {"domain": [-70, 70], "range": [330, 28]}},
        "size": {"field": "activations", "type": "quantitative", "scale": {"range": [260, 5200]}, "legend": null},
        "color": {
          "field": "hazard_group",
          "type": "nominal",
          "title": "Hazard",
          "scale": {
            "domain": ["Flood / Rainfall", "Storm", "Bushfire", "Cyclone / Tropical Low", "Other"],
            "range": ["#246a8d", "#6c5f9f", "#c85a2e", "#5f7fa3", "#8b7a62"]
          }
        },
        "tooltip": [
          {"field": "hazard_group", "type": "nominal", "title": "Hazard"},
          {"field": "activations", "type": "quantitative", "title": "Activations", "format": ","}
        ]
      }
    },
    {
      "mark": {"type": "text", "font": "Trebuchet MS", "fontSize": 13, "fontWeight": "bold", "color": "#18211d"},
      "encoding": {
        "x": {"field": "label_x", "type": "quantitative", "axis": null, "scale": {"domain": [-70, 70], "range": [15, 415]}},
        "y": {"field": "label_y", "type": "quantitative", "axis": null, "scale": {"domain": [-70, 70], "range": [330, 28]}},
        "text": {"field": "hazard_label", "type": "nominal"}
      }
    }
  ],
  "config": {
    "background": null,
    "legend": {"labelFont": "Trebuchet MS", "titleFont": "Trebuchet MS"},
    "title": {"font": "Georgia", "fontSize": 17, "subtitleFont": "Trebuchet MS", "subtitleFontSize": 12, "anchor": "start"},
    "view": {"stroke": null}
  }
}
