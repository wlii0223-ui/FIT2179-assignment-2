{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Four hazard groups over time",
    "subtitle": "Split into two rows so each hazard profile has room for readable year labels.",
    "fontSize": 32,
    "subtitleFontSize": 17,
    "subtitlePadding": 10,
    "offset": 16
  },
  "data": {"url": "../processed_data/drfa_year_hazard.csv"},
  "vconcat": [
    {
      "hconcat": [
        {
          "width": 420,
          "height": 150,
          "title": "Bushfire",
          "transform": [{"filter": "datum.hazard_group == 'Bushfire'"}],
          "layer": [
            {
              "mark": {"type": "area", "interpolate": "monotone", "opacity": 0.72, "color": "#c85a2e"},
              "encoding": {
                "x": {
                  "field": "year",
                  "type": "quantitative",
                  "title": null,
                  "scale": {"domain": [2006, 2026]},
                  "axis": {"values": [2006, 2010, 2015, 2020, 2025], "format": "d", "labelAngle": 0}
                },
                "y": {"field": "activations", "type": "quantitative", "title": "Activations", "scale": {"domain": [0, 180]}},
                "tooltip": [
                  {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
                  {"field": "hazard_group", "type": "nominal", "title": "Hazard"},
                  {"field": "activations", "type": "quantitative", "title": "Activations", "format": ","}
                ]
              }
            },
            {
              "transform": [{"filter": "datum.year == 2019"}],
              "mark": {"type": "point", "filled": true, "size": 70, "color": "#c85a2e", "stroke": "#fffaf1", "strokeWidth": 1.5},
              "encoding": {
                "x": {"field": "year", "type": "quantitative", "scale": {"domain": [2006, 2026]}},
                "y": {"field": "activations", "type": "quantitative", "scale": {"domain": [0, 180]}}
              }
            },
            {
              "transform": [{"filter": "datum.year == 2019"}],
              "mark": {"type": "text", "align": "right", "baseline": "bottom", "dx": -8, "dy": -6, "font": "Trebuchet MS", "fontSize": 12, "fontWeight": "bold", "color": "#8e3423"},
              "encoding": {
                "x": {"field": "year", "type": "quantitative", "scale": {"domain": [2006, 2026]}},
                "y": {"field": "activations", "type": "quantitative", "scale": {"domain": [0, 180]}},
                "text": {"value": "2019 peak: 161"}
              }
            }
          ]
        },
        {
          "width": 420,
          "height": 150,
          "title": "Cyclone / Tropical Low",
          "transform": [{"filter": "datum.hazard_group == 'Cyclone / Tropical Low'"}],
          "layer": [
            {
              "mark": {"type": "area", "interpolate": "monotone", "opacity": 0.72, "color": "#5f7fa3"},
              "encoding": {
                "x": {
                  "field": "year",
                  "type": "quantitative",
                  "title": null,
                  "scale": {"domain": [2006, 2026]},
                  "axis": {"values": [2006, 2010, 2015, 2020, 2025], "format": "d", "labelAngle": 0}
                },
                "y": {"field": "activations", "type": "quantitative", "title": null, "scale": {"domain": [0, 115]}},
                "tooltip": [
                  {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
                  {"field": "hazard_group", "type": "nominal", "title": "Hazard"},
                  {"field": "activations", "type": "quantitative", "title": "Activations", "format": ","}
                ]
              }
            },
            {
              "transform": [{"filter": "datum.year == 2025"}],
              "mark": {"type": "point", "filled": true, "size": 70, "color": "#5f7fa3", "stroke": "#fffaf1", "strokeWidth": 1.5},
              "encoding": {
                "x": {"field": "year", "type": "quantitative", "scale": {"domain": [2006, 2026]}},
                "y": {"field": "activations", "type": "quantitative", "scale": {"domain": [0, 115]}}
              }
            },
            {
              "transform": [{"filter": "datum.year == 2025"}],
              "mark": {"type": "text", "align": "right", "baseline": "bottom", "dx": -8, "dy": -6, "font": "Trebuchet MS", "fontSize": 12, "fontWeight": "bold", "color": "#3e5878"},
              "encoding": {
                "x": {"field": "year", "type": "quantitative", "scale": {"domain": [2006, 2026]}},
                "y": {"field": "activations", "type": "quantitative", "scale": {"domain": [0, 115]}},
                "text": {"value": "2025 peak: 101"}
              }
            }
          ]
        }
      ]
    },
    {
      "hconcat": [
        {
          "width": 420,
          "height": 150,
          "title": "Flood / Rainfall",
          "transform": [{"filter": "datum.hazard_group == 'Flood / Rainfall'"}],
          "layer": [
            {
              "mark": {"type": "area", "interpolate": "monotone", "opacity": 0.72, "color": "#246a8d"},
              "encoding": {
                "x": {
                  "field": "year",
                  "type": "quantitative",
                  "title": null,
                  "scale": {"domain": [2006, 2026]},
                  "axis": {"values": [2006, 2010, 2015, 2020, 2025], "format": "d", "labelAngle": 0}
                },
                "y": {"field": "activations", "type": "quantitative", "title": "Activations", "scale": {"domain": [0, 560]}},
                "tooltip": [
                  {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
                  {"field": "hazard_group", "type": "nominal", "title": "Hazard"},
                  {"field": "activations", "type": "quantitative", "title": "Activations", "format": ","}
                ]
              }
            },
            {
              "transform": [{"filter": "datum.year == 2022"}],
              "mark": {"type": "point", "filled": true, "size": 70, "color": "#246a8d", "stroke": "#fffaf1", "strokeWidth": 1.5},
              "encoding": {
                "x": {"field": "year", "type": "quantitative", "scale": {"domain": [2006, 2026]}},
                "y": {"field": "activations", "type": "quantitative", "scale": {"domain": [0, 560]}}
              }
            },
            {
              "transform": [{"filter": "datum.year == 2022"}],
              "mark": {"type": "text", "align": "right", "baseline": "bottom", "dx": -8, "dy": -6, "font": "Trebuchet MS", "fontSize": 12, "fontWeight": "bold", "color": "#246a8d"},
              "encoding": {
                "x": {"field": "year", "type": "quantitative", "scale": {"domain": [2006, 2026]}},
                "y": {"field": "activations", "type": "quantitative", "scale": {"domain": [0, 560]}},
                "text": {"value": "2022 peak: 511"}
              }
            }
          ]
        },
        {
          "width": 420,
          "height": 150,
          "title": "Storm",
          "transform": [{"filter": "datum.hazard_group == 'Storm'"}],
          "layer": [
            {
              "mark": {"type": "area", "interpolate": "monotone", "opacity": 0.72, "color": "#6c5f9f"},
              "encoding": {
                "x": {
                  "field": "year",
                  "type": "quantitative",
                  "title": null,
                  "scale": {"domain": [2006, 2026]},
                  "axis": {"values": [2006, 2010, 2015, 2020, 2025], "format": "d", "labelAngle": 0}
                },
                "y": {"field": "activations", "type": "quantitative", "title": null, "scale": {"domain": [0, 165]}},
                "tooltip": [
                  {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
                  {"field": "hazard_group", "type": "nominal", "title": "Hazard"},
                  {"field": "activations", "type": "quantitative", "title": "Activations", "format": ","}
                ]
              }
            },
            {
              "transform": [{"filter": "datum.year == 2021"}],
              "mark": {"type": "point", "filled": true, "size": 70, "color": "#6c5f9f", "stroke": "#fffaf1", "strokeWidth": 1.5},
              "encoding": {
                "x": {"field": "year", "type": "quantitative", "scale": {"domain": [2006, 2026]}},
                "y": {"field": "activations", "type": "quantitative", "scale": {"domain": [0, 165]}}
              }
            },
            {
              "transform": [{"filter": "datum.year == 2021"}],
              "mark": {"type": "text", "align": "left", "baseline": "bottom", "dx": 8, "dy": -6, "font": "Trebuchet MS", "fontSize": 12, "fontWeight": "bold", "color": "#6c5f9f"},
              "encoding": {
                "x": {"field": "year", "type": "quantitative", "scale": {"domain": [2006, 2026]}},
                "y": {"field": "activations", "type": "quantitative", "scale": {"domain": [0, 165]}},
                "text": {"value": "2021 peak: 144"}
              }
            }
          ]
        }
      ]
    }
  ],
  "config": {
    "background": null,
    "concat": {"spacing": 28},
    "axis": {"labelFont": "Trebuchet MS", "titleFont": "Trebuchet MS", "labelFontSize": 12, "titleFontSize": 13, "gridColor": "#e7dfd2", "domain": false},
    "title": {"font": "Georgia", "fontSize": 20, "subtitleFont": "Trebuchet MS", "subtitleFontSize": 14, "anchor": "start", "offset": 12},
    "view": {"stroke": null}
  }
}
